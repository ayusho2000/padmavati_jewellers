generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum AdminRole {
  OWNER
  ADMIN
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  GOLD
  DIAMOND
  POLKI
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Admin {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(ADMIN)
  status       AdminStatus @default(ACTIVE)
  lastLogin    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  passwordResetOTPs  PasswordResetOTP[]
  passwordChangeOTPs PasswordChangeOTP[]
}

model PasswordResetOTP {
  id        Int      @id @default(autoincrement())
  adminId   Int
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model PasswordChangeOTP {
  id        Int      @id @default(autoincrement())
  adminId   Int
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Hero {
  id        Int      @id @default(autoincrement())
  video     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id           Int             @id @default(autoincrement())
  category     ProductCategory
  name         String
  description  String?

  type         String?
  purity       String?
  weight       String?
  style        String?

  image        String
  image2       String?
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category])
  @@index([active])
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  customerName String
  designation  String?
  text         String
  rating       Int      @default(5)
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

model InstagramPost {
  id           Int       @id @default(autoincrement())
  mediaType    MediaType
  media        String
  link         String?
  caption      String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

model ContactSubmission {
  id          Int           @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  message     String
  status      ContactStatus @default(NEW)
  submittedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([submittedAt])
}

model Media {
  id           Int       @id @default(autoincrement())
  fileName     String
  originalName String
  filePath     String
  mimeType     String
  mediaType    MediaType
  fileSize     Int
  createdAt    DateTime  @default(now())
}




model Collection {
  id          Int             @id @default(autoincrement())
  category    ProductCategory @unique
  title       String
  description String          @db.Text
  bannerImage String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active])
}
